{
  "name": "devops-pipeline-demo",
  "version": "0.1.0",
  "description": "Minimal Node.js/TypeScript todo REST API demonstrating a GitHub Actions CI/CD pipeline.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.5.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.9.0",
    "fast-check": "^3.21.0",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
